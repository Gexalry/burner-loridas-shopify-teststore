      "label": "Hero benefits"
    },
    {
      "type": "url",
      "id": "proof_url",
      "label": "Research source"
    },
    {
      "type": "text",
      "id": "ui_product_details",
      "label": "Product details"
    },
    {
      "type": "text",
      "id": "ui_one_time",
      "label": "One time"
    },
    {
      "type": "text",
      "id": "ui_add_to_cart",
