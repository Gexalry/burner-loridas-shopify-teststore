{{ 'goodwell-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'goodwell-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_images = product.media | where: 'media_type', 'image'
  assign form_id = 'GoodwellForm-' | append: section.id
  assign offer_id = 'GoodwellOffer-' | append: section.id
  assign story_blocks = section.blocks | where: 'type', 'story'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign offer_blocks = section.blocks | where: 'type', 'offer'
-%}

<div id="Goodwell-{{ section.id }}" class="gw-product" data-goodwell-product
  style="--gw-ink: {{ section.settings.ink }}; --gw-bg: {{ section.settings.background }}; --gw-accent: {{ section.settings.accent }}; --gw-soft: {{ section.settings.soft }}; --gw-action: {{ section.settings.action }};"
>
  <nav class="gw-navigation gw-wrap" aria-label="Store">
    <a class="gw-brand" href="{{ routes.root_url }}">{{ product.vendor | escape }}<span aria-hidden="true">.</span></a>
    <a class="gw-cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart.view' | t: count: cart.item_count | escape }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg>
      <span>{{ 'sections.cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span>
    </a>
  </nav>
  <section class="gw-hero gw-wrap" aria-labelledby="GoodwellHeading-{{ section.id }}">
    <div class="gw-visual">
      <div class="gw-gallery" data-gw-gallery aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
        {%- for media in product_images -%}
          <div class="gw-slide" id="GoodwellMedia-{{ section.id }}-{{ forloop.index }}" data-gw-slide>
            {%- if forloop.first -%}
              {{ media | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 1000px) 50vw, 100vw', class: 'gw-product-image' }}
            {%- else -%}
              {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1000px) 50vw, 100vw', class: 'gw-product-image' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if product_images.size > 1 -%}
        <div class="gw-thumbnails" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
          {%- for media in product_images -%}
            <a class="gw-thumbnail" href="#GoodwellMedia-{{ section.id }}-{{ forloop.index }}" data-gw-thumbnail="{{ forloop.index0 }}" aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160', sizes: '72px' }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="gw-visual-caption">{{ section.settings.formula | escape }}</div>
    </div>

    <div class="gw-introduction">
      <p class="gw-eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
      <h1 id="GoodwellHeading-{{ section.id }}">{{ section.settings.headline | escape }}</h1>
      <p class="gw-lead">{{ section.settings.subheadline | escape }}</p>
      <div class="gw-benefits">{{ section.settings.benefits }}</div>

      <div class="gw-offer" id="{{ offer_id }}" data-gw-offer>
        <h2 class="gw-offer-heading">{{ section.settings.offer_heading | escape }}</h2>
        <p class="gw-offer-body">{{ section.settings.offer_body | escape }}</p>
        {% form 'product', product, id: form_id, class: 'gw-form' %}
          {{ form.errors | default_errors }}
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          <fieldset class="gw-variants">
            <legend class="gw-visually-hidden">{{ 'products.product.product_variants' | t }}</legend>
            {%- for variant in product.variants -%}
              {%- assign option_copy = offer_blocks[forloop.index0] -%}
              <label class="gw-variant">
                <input type="radio" name="id" value="{{ variant.id }}" data-gw-variant data-price="{{ variant.price | money_with_currency | escape }}" data-available="{{ variant.available }}"{% if variant.id == current_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <span class="gw-variant-card">
                  <span class="gw-variant-top"><span class="gw-radio" aria-hidden="true"></span><strong>{{ variant.title | escape }}</strong><span class="gw-variant-price">{{ variant.price | money }}</span></span>
                  {%- if option_copy.settings.description != blank -%}<span class="gw-variant-description">{{ option_copy.settings.description | escape }}</span>{%- endif -%}
                  {%- unless variant.available -%}<span class="gw-variant-description">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
                </span>
              </label>
            {%- endfor -%}
          </fieldset>
          <button class="gw-button gw-add" type="submit" name="add" data-gw-submit data-available-label="{{ 'products.product.add_to_cart' | t | escape }}" data-unavailable-label="{{ 'products.product.sold_out' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
            <span data-gw-submit-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            <span class="gw-button-arrow" aria-hidden="true">↗</span>
          </button>
          <div class="gw-purchase-meta">
            <span data-gw-price aria-live="polite">{{ current_variant.price | money_with_currency }}</span>
            <span>{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</span>
          </div>
        {% endform %}
      </div>
    </div>
  </section>

  <div class="gw-facts-band"><div class="gw-wrap gw-facts">{{ section.settings.facts }}</div></div>

  <div class="gw-story gw-wrap">
    {%- for block in story_blocks -%}
      <section class="gw-story-section gw-story-{{ block.settings.presentation }}" id="GoodwellStory-{{ section.id }}-{{ block.id }}" aria-labelledby="GoodwellStoryHeading-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="gw-story-heading">
          <span class="gw-section-number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h2 id="GoodwellStoryHeading-{{ section.id }}-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
          {%- if block.settings.presentation == 'mechanism' -%}
            <div class="gw-cell-illustration" aria-hidden="true"><span></span><i></i><b></b></div>
          {%- endif -%}
        </div>
        <div class="gw-story-content">
          <div class="gw-richtext">{{ block.settings.body }}</div>
          {%- if block.settings.bullets != blank -%}<div class="gw-story-bullets">{{ block.settings.bullets }}</div>{%- endif -%}
          {%- if block.settings.sources != blank -%}<div class="gw-citations">{{ block.settings.sources }}</div>{%- endif -%}
        </div>
      </section>
    {%- endfor -%}
  </div>

  <section class="gw-faq-section" aria-labelledby="GoodwellFAQ-{{ section.id }}">
    <div class="gw-wrap gw-faq-layout">
      <div class="gw-faq-intro"><span class="gw-eyebrow">FAQ</span><h2 id="GoodwellFAQ-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2><p>{{ section.settings.formula | escape }}</p></div>
      <div class="gw-faq-list">
        {%- for block in faq_blocks -%}
          {%- if block.settings.requires_refund_policy and shop.refund_policy.body == blank -%}{%- continue -%}{%- endif -%}
          <details class="gw-faq" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}<span class="gw-faq-symbol" aria-hidden="true"></span></summary>
            <div class="gw-faq-answer"><div class="gw-richtext">{{ block.settings.answer }}</div>{%- if block.settings.sources != blank -%}<div class="gw-citations">{{ block.settings.sources }}</div>{%- endif -%}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="gw-closing gw-wrap" aria-labelledby="GoodwellClosing-{{ section.id }}">
    <p class="gw-eyebrow">{{ product.vendor | escape }}</p>
    <h2 id="GoodwellClosing-{{ section.id }}">{{ section.settings.closing_headline | escape }}</h2>
    <p>{{ section.settings.closing_body | escape }}</p>
    <a class="gw-button" href="#{{ offer_id }}">{{ section.settings.closing_cta | escape }}<span aria-hidden="true">↗</span></a>
  </section>

  <div class="gw-disclosures gw-wrap">
    <div class="gw-richtext">{{ section.settings.disclosures }}</div>
    <nav class="gw-policies" aria-label="Policies">
      {%- for policy in shop.policies -%}{%- if policy.body != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}{%- endfor -%}
    </nav>
  </div>

  <div class="gw-sticky" data-gw-sticky hidden>
    <div class="gw-wrap gw-sticky-inner"><div><strong>{{ product.title | escape }}</strong><span data-gw-price>{{ current_variant.price | money_with_currency }}</span></div><a class="gw-button" href="#{{ offer_id }}">{{ 'products.product.choose_options' | t }}<span aria-hidden="true">↑</span></a></div>
  </div>
</div>

{% schema %}
{
  "name": "Goodwell audience product",
  "tag": "section",
  "class": "goodwell-product-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "color", "id": "ink", "label": "Text", "default": "#2c3e50" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f9f7f2" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#4a90e2" },
    { "type": "color", "id": "soft", "label": "Soft background", "default": "#e9eef2" },
    { "type": "color", "id": "action", "label": "Button background", "default": "#174c79" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "headline", "label": "Headline" },
    { "type": "textarea", "id": "subheadline", "label": "Introduction" },
    { "type": "richtext", "id": "benefits", "label": "Hero bullets" },
    { "type": "text", "id": "formula", "label": "Formula summary" },
    { "type": "richtext", "id": "facts", "label": "Product facts" },
    { "type": "text", "id": "offer_heading", "label": "Offer heading" },
    { "type": "textarea", "id": "offer_body", "label": "Offer description" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "closing_headline", "label": "Closing headline" },
    { "type": "textarea", "id": "closing_body", "label": "Closing text" },
    { "type": "text", "id": "closing_cta", "label": "Closing button" },
    { "type": "richtext", "id": "disclosures", "label": "Product disclosures" }
  ],
  "blocks": [
    { "type": "story", "name": "Page section", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "richtext", "id": "body", "label": "Body" },
      { "type": "richtext", "id": "bullets", "label": "Bullets" },
      { "type": "richtext", "id": "sources", "label": "Research sources" },
      { "type": "select", "id": "presentation", "label": "Presentation", "default": "editorial", "options": [
        { "value": "editorial", "label": "Editorial" },
        { "value": "mechanism", "label": "Mechanism" },
        { "value": "proof", "label": "Research card" },
        { "value": "product", "label": "Product details" }
      ] }
    ] },
    { "type": "offer", "name": "Bundle description", "limit": 5, "settings": [
      { "type": "textarea", "id": "description", "label": "Description", "info": "Matches the product variant at this position. Prices and variant labels come directly from Shopify." }
    ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" },
      { "type": "richtext", "id": "sources", "label": "Research sources" },
      { "type": "checkbox", "id": "requires_refund_policy", "label": "Show only when refund policy exists", "default": false }
    ] }
  ],
  "max_blocks": 40,
  "presets": [{ "name": "Goodwell audience product" }]
}
{% endschema %}
