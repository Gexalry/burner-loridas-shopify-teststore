      "type": "faq",
      "name": "FAQ",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Goodwell audience product"
    }
  ]
}
{% endschema %}
