{{ 'goodwell-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'goodwell-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_images = product.media | where: 'media_type', 'image'
  assign form_id = 'GoodwellForm-' | append: section.id
  assign offer_id = 'GoodwellOffer-' | append: section.id
  assign details_id = 'GoodwellDetails-' | append: section.id
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign mechanism_blocks = section.blocks | where: 'type', 'mechanism'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
-%}

<div id="Goodwell-{{ section.id }}" class="gw-product" data-goodwell-product data-design-version="2"
  style="--gw-ink: {{ section.settings.ink }}; --gw-bg: {{ section.settings.background }}; --gw-accent: {{ section.settings.accent }}; --gw-soft: {{ section.settings.soft }}; --gw-action: {{ section.settings.action }};"
>
  <nav class="gw-navigation gw-wrap" aria-label="{{ shop.name | escape }}">
    <a class="gw-brand" href="{{ routes.root_url }}">{{ product.vendor | escape }}<span aria-hidden="true">.</span></a>
    <div class="gw-nav-links"><a href="#{{ details_id }}">{{ section.settings.ui_product_details | escape }}</a><a href="#GoodwellFAQ-{{ section.id }}">FAQ</a></div>
    <a class="gw-cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart.view' | t: count: cart.item_count | escape }}">
      <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg>
      <span>{{ 'sections.cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span>
    </a>
  </nav>

  <section class="gw-hero gw-wrap" aria-labelledby="GoodwellHeading-{{ section.id }}">
    <div class="gw-visual">
      <div class="gw-gallery" data-gw-gallery aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
        {%- for media in product_images -%}
          <div class="gw-slide" id="GoodwellMedia-{{ section.id }}-{{ forloop.index }}" data-gw-slide>
            {%- if forloop.first -%}
              {{ media | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 1250px) 570px, (min-width: 800px) 48vw, 100vw', class: 'gw-product-image' }}
            {%- else -%}
              {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1250px) 570px, (min-width: 800px) 48vw, 100vw', class: 'gw-product-image' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if product_images.size > 1 -%}
        <div class="gw-thumbnails" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
          {%- for media in product_images -%}
            <a class="gw-thumbnail" href="#GoodwellMedia-{{ section.id }}-{{ forloop.index }}" data-gw-thumbnail="{{ forloop.index0 }}" aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160', sizes: '56px' }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="gw-introduction">
      <p class="gw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="GoodwellHeading-{{ section.id }}">{{ section.settings.headline | escape }}</h1>
      <p class="gw-lead">{{ section.settings.subheadline | escape }}</p>
      <div class="gw-benefits">{{ section.settings.benefits }}</div>
      <div class="gw-offer" id="{{ offer_id }}" data-gw-offer>
        <div class="gw-offer-title"><h2>{{ section.settings.offer_heading | escape }}</h2><span>{{ section.settings.ui_one_time | escape }}</span></div>
        {% form 'product', product, id: form_id, class: 'gw-form' %}
          {{ form.errors | default_errors }}
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          <fieldset class="gw-variants">
            <legend class="gw-visually-hidden">{{ 'products.product.product_variants' | t }}</legend>
            {%- for variant in product.variants -%}
              {%- liquid
                assign bottle_count = variant.metafields.goodwell.bottle_count.value | default: 1 | plus: 0
                if bottle_count < 1
                  assign bottle_count = 1
                endif
                assign per_bottle = variant.price | divided_by: bottle_count
              -%}
              <label class="gw-variant">
                <input type="radio" name="id" value="{{ variant.id }}" data-gw-variant data-price="{{ variant.price | money_with_currency | escape }}" data-available="{{ variant.available }}"{% if variant.id == current_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <span class="gw-variant-card">
                  <span class="gw-radio" aria-hidden="true"></span>
                  <span class="gw-variant-name">{{ variant.title | escape }}{% unless variant.available %}<small>{{ 'products.product.sold_out' | t | escape }}</small>{% endunless %}</span>
                  <span class="gw-variant-prices"><strong>{{ variant.price | money }}</strong>{% if bottle_count > 1 %}<small>{{ per_bottle | money }} {{ section.settings.ui_bottle_unit | escape }}</small>{% endif %}</span>
                </span>
              </label>
            {%- endfor -%}
          </fieldset>
          <button class="gw-button gw-add" type="submit" name="add" data-gw-submit data-available-label="{{ section.settings.ui_add_to_cart | escape }}" data-unavailable-label="{{ 'products.product.sold_out' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
            <span data-gw-submit-label>{% if current_variant.available %}{{ section.settings.ui_add_to_cart | escape }}{% else %}{{ 'products.product.sold_out' | t | escape }}{% endif %}</span>
            <span class="gw-button-price" data-gw-price>{{ current_variant.price | money_with_currency }}</span>
            <span class="gw-button-arrow" aria-hidden="true">→</span>
          </button>
          <p class="gw-purchase-note">{{ section.settings.offer_note | escape }}</p>
          <p class="gw-checkout-note">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
        {% endform %}
        <div class="gw-trust" aria-label="{{ section.settings.ui_product_details | escape }}">
          {%- for block in trust_blocks -%}
            <div class="gw-trust-item" {{ block.shopify_attributes }}>
              <svg width="26" height="26" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'lock' -%}<rect x="7" y="14" width="18" height="14" rx="3"/><path d="M11 14V9a5 5 0 0 1 10 0v5"/><circle cx="16" cy="20" r="1.2"/><path d="M16 21v3"/>
                  {%- when 'ingredients' -%}<path d="M8 4h12l5 5v19H8Z"/><path d="M20 4v6h5M12 14h9M12 18h9M12 22h6"/>
                  {%- else -%}<rect x="10" y="3" width="12" height="5" rx="1"/><path d="M11 8v3l-4 4v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V15l-4-4V8M7 17h18M7 24h18"/><path d="m13 20 2 2 4-4"/>
                {%- endcase -%}
              </svg>
              <strong>{{ block.settings.label | escape }}</strong>
              <span>{{ block.settings.detail | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- unless shop.enabled_payment_types == empty -%}
          <ul class="gw-payments" role="list" aria-label="{{ section.settings.ui_payment_methods | escape }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'gw-payment-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endunless -%}
      </div>
    </div>
  </section>

  <div class="gw-facts-band"><dl class="gw-wrap gw-facts">
    {%- for block in fact_blocks -%}<div {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}</dd></div>{%- endfor -%}
  </dl></div>

  <section class="gw-lifestyle gw-wrap gw-section" aria-labelledby="GoodwellLifestyle-{{ section.id }}">
    <div class="gw-lifestyle-image">
      {%- if section.settings.lifestyle_asset != blank -%}
        <img src="{{ section.settings.lifestyle_asset | asset_url }}" alt="{{ section.settings.lifestyle_alt | escape }}" width="1254" height="1254" loading="lazy">
      {%- endif -%}
    </div>
    <div class="gw-lifestyle-copy"><span class="gw-overline" aria-hidden="true"></span><h2 id="GoodwellLifestyle-{{ section.id }}">{{ section.settings.lifestyle_heading | escape }}</h2><p>{{ section.settings.lifestyle_body | escape }}</p><a class="gw-text-link" href="#{{ offer_id }}">{{ section.settings.hero_cta | escape }} <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="gw-mechanism gw-section" aria-labelledby="GoodwellMechanism-{{ section.id }}">
    <div class="gw-wrap"><h2 id="GoodwellMechanism-{{ section.id }}">{{ section.settings.mechanism_heading | escape }}</h2>
      <ol class="gw-mechanism-cards">
        {%- for block in mechanism_blocks -%}
          <li {{ block.shopify_attributes }}><span class="gw-step" aria-hidden="true">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></li>
        {%- endfor -%}
      </ol>
    </div>
  </section>

  <section class="gw-proof gw-wrap gw-section" aria-labelledby="GoodwellProof-{{ section.id }}">
    <div class="gw-proof-card">
      <div class="gw-proof-intro">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M8 5h14l6 6v20H8Z"/><path d="M22 5v7h6M12 17h12M12 21h12M12 25h7"/></svg>
        <h2 id="GoodwellProof-{{ section.id }}">{{ section.settings.proof_label | escape }}</h2>
        <p class="gw-proof-population">{{ section.settings.proof_population | escape }}</p>
      </div>
      <div class="gw-proof-finding">
        <p class="gw-proof-summary">{{ section.settings.proof_finding | escape }}</p>
        <p class="gw-proof-scope">{{ section.settings.proof_scope | escape }}</p>
        <details class="gw-research-details"><summary>{{ section.settings.ui_study_details | escape }}<span class="gw-expand" aria-hidden="true"></span></summary><div><p>{{ section.settings.proof_population | escape }}</p><a href="{{ section.settings.proof_url }}" target="_blank" rel="noopener" class="gw-text-link">{{ section.settings.proof_link_label | escape }} <span aria-hidden="true">↗</span></a></div></details>
      </div>
    </div>
  </section>

  <section class="gw-ritual gw-wrap gw-section" id="{{ details_id }}" aria-labelledby="GoodwellRitual-{{ section.id }}">
    <div class="gw-ritual-copy"><p class="gw-eyebrow">{{ section.settings.ui_product_details | escape }}</p><h2 id="GoodwellRitual-{{ section.id }}">{{ section.settings.ritual_heading | escape }}</h2><p>{{ section.settings.ritual_body | escape }}</p></div>
    <div class="gw-formula">
      <h3>{{ section.settings.ui_formula_heading | escape }}</h3>
      <dl><div><dt>{{ section.settings.ui_serving_size | escape }}</dt><dd>2 capsules</dd></div><div><dt>Spermidine 3HCL</dt><dd>10 mg</dd></div><div><dt>{{ section.settings.ui_ingredients | escape }}</dt><dd>Spermidine 3HCL, HPMC, rice flour</dd></div></dl>
    </div>
  </section>

  <section class="gw-faq-section gw-section" aria-labelledby="GoodwellFAQ-{{ section.id }}">
    <div class="gw-wrap gw-faq-layout">
      <div class="gw-faq-intro"><p class="gw-eyebrow">FAQ</p><h2 id="GoodwellFAQ-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2></div>
      <div class="gw-faq-list">
        {%- for block in faq_blocks -%}
          <details class="gw-faq" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span class="gw-expand" aria-hidden="true"></span></summary><div class="gw-faq-answer"><p>{{ block.settings.answer | escape }}</p></div></details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="gw-closing gw-wrap gw-section" aria-labelledby="GoodwellClosing-{{ section.id }}">
    <h2 id="GoodwellClosing-{{ section.id }}">{{ section.settings.closing_headline | escape }}</h2><p>{{ section.settings.closing_body | escape }}</p><a class="gw-button" href="#{{ offer_id }}">{{ section.settings.closing_cta | escape }}<span aria-hidden="true">→</span></a>
  </section>
  <div class="gw-disclosures gw-wrap"><p>{{ section.settings.disclosures | escape }}</p><nav class="gw-policies" aria-label="{{ shop.name | escape }}">{%- for policy in shop.policies -%}{%- if policy.body != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}{%- endfor -%}</nav></div>
  <div class="gw-sticky" data-gw-sticky hidden><div class="gw-wrap gw-sticky-inner"><div><strong>{{ product.vendor | escape }} Spermidine</strong><span data-gw-price>{{ current_variant.price | money_with_currency }}</span></div><a class="gw-button" href="#{{ offer_id }}">{{ section.settings.ui_choose_options | escape }}<span aria-hidden="true">↑</span></a></div></div>
</div>

{% schema %}
{
  "name": "Goodwell audience product",
  "tag": "section",
  "class": "goodwell-product-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "ink",
      "label": "Text",
      "default": "#362532"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fbf8f4"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#a67b67"
    },
    {
      "type": "color",
      "id": "soft",
      "label": "Soft background",
      "default": "#eee5e9"
    },
    {
      "type": "color",
      "id": "action",
      "label": "Button background",
      "default": "#4d263f"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Story button"
    },
    {
      "type": "text",
      "id": "offer_heading",
      "label": "Offer heading"
    },
    {
      "type": "text",
      "id": "lifestyle_asset",
      "label": "Lifestyle asset filename"
    },
    {
      "type": "text",
      "id": "lifestyle_alt",
      "label": "Lifestyle image description"
    },
    {
      "type": "text",
      "id": "mechanism_heading",
      "label": "Mechanism heading"
    },
    {
      "type": "text",
      "id": "proof_label",
      "label": "Research title"
    },
    {
      "type": "text",
      "id": "proof_population",
      "label": "Research population"
    },
    {
      "type": "text",
      "id": "proof_link_label",
      "label": "Research link"
    },
    {
      "type": "text",
      "id": "ritual_heading",
      "label": "Ritual heading"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ heading"
    },
    {
      "type": "text",
      "id": "closing_cta",
      "label": "Closing button"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Introduction"
    },
    {
      "type": "textarea",
      "id": "offer_note",
      "label": "Offer note"
    },
    {
      "type": "textarea",
      "id": "lifestyle_heading",
      "label": "Lifestyle heading"
    },
    {
      "type": "textarea",
      "id": "lifestyle_body",
      "label": "Lifestyle text"
    },
    {
      "type": "textarea",
      "id": "proof_finding",
      "label": "Research finding"
    },
    {
      "type": "textarea",
      "id": "proof_scope",
      "label": "Research scope"
    },
    {
      "type": "textarea",
      "id": "ritual_body",
      "label": "Ritual text"
    },
    {
      "type": "textarea",
      "id": "closing_headline",
      "label": "Closing headline"
    },
    {
      "type": "textarea",
      "id": "closing_body",
      "label": "Closing text"
    },
    {
      "type": "textarea",
      "id": "disclosures",
